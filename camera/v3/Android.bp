package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_prebuilt_library_shared {
    name: "libispaaa",
    vendor: true,
    compile_multilib: "both",
    check_elf_files: false,
    arch: {
        arm64: {
            srcs: ["isplib/lib64/libispaaa.so"],
        },
        arm: {
            srcs: ["isplib/lib/libispaaa.so"],
        },
        x86: {
            enabled:false,
        },
        x86_64: {
            enabled:false,
        },
    },
}
cc_prebuilt_library_shared {
    name: "libispaml",
    vendor: true,
    compile_multilib: "both",
    check_elf_files: false,
    arch: {
        arm: {
            srcs: ["isplib/lib/libispaml.so"],
        },
        arm64: {
            srcs: ["isplib/lib64/libispaml.so"],
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            enabled: false,
        },

    },
}

cc_prebuilt_library_shared {
    name: "libnn_face",
    vendor: true,
    compile_multilib: "both",
    check_elf_files: false,
    arch: {
        arm64: {
            srcs: ["isplib/lib64/libnn_face.so"],
        },
        arm: {
            srcs: ["isplib/lib/libnn_face.so"],
        },
        x86: {
            enabled:false,
        },
        x86_64: {
            enabled:false,
        },
    },
}