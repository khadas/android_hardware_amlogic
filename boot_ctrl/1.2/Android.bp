package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_library_shared {
    name: "android.hardware.boot@1.2-impl.droidlogic",
    stem: "android.hardware.boot@1.0-impl-1.2.droidlogic",
    defaults: [
        "hidl_defaults",
        "libboot_control_defaults_droidlogic",
    ],
    relative_install_path: "hw",
    vendor: true,
    recovery_available: true,
    srcs: ["BootControl.cpp"],

    shared_libs: [
        "liblog",
        "libhidlbase",
        "libhardware",
        "libutils",
        "android.hardware.boot@1.0",
        "android.hardware.boot@1.1",
        "android.hardware.boot@1.2",
    ],
    static_libs: [
        "libboot_control_droidlogic",
        "libfstab",
        "libsystemcontrol_static",
        "libcutils",
        "libz",
    ],
    whole_static_libs: [
        "libsystemcontrol_static",
    ],
}


prebuilt_etc {
    name: "android.hardware.boot@1.2-bootloader.rc",
    src: "android.hardware.boot@1.2-bootloader.rc",
    relative_install_path: "init",
    vendor: true,
}

cc_binary {
    name: "android.hardware.boot@1.2-service.droidlogic",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.boot@1.2-service.droidlogic.rc"],
    srcs: ["service.cpp"],

    vintf_fragments: [
        "android.hardware.boot@1.2.droidlogic.xml",
    ],

    shared_libs: [
        "liblog",
        "libhardware",
        "libhidlbase",
        "libutils",
        "android.hardware.boot@1.0",
        "android.hardware.boot@1.1",
        "android.hardware.boot@1.2",
    ],

}
