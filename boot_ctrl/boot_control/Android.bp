package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_defaults {
    name: "libboot_control_defaults_droidlogic",
    relative_install_path: "hw",

    cflags: [
        "-D_FILE_OFFSET_BITS=64",
        "-Werror",
        "-Wall",
        "-Wextra",
    ],

    shared_libs: [
        "android.hardware.boot@1.1",
        "libbase",
        "liblog",
    ],
    static_libs: [
        "libbootloader_message",
        "libfstab",
    ],
}

cc_library_static {
    name: "libboot_control_droidlogic",
    defaults: ["libboot_control_defaults_droidlogic"],
    export_include_dirs: ["include"],
    recovery_available: true,
    vendor_available: true,

    srcs: [
        "libboot_control.cpp",
        "systemcontrol.cpp",
    ],
    static_libs: [
        "libcutils",
        "libz",
    ],
    whole_static_libs: [
        "libsystemcontrol_static",
        "libmeson_display_adapter_local_static",
    ],
    product_variables: {
        platform_sdk_version: {
            cflags: ["-DPLATFORM_SDK_VERSION=%d"],
        }
    },

    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",

        "libz",
        "libsystemcontrolservice",
        "vendor.amlogic.hardware.systemcontrol@1.0",
        "vendor.amlogic.hardware.systemcontrol@1.1",
        "android.hardware.boot-V1-ndk",
    ],

    include_dirs: [
         "vendor/amlogic/common/frameworks/services/systemcontrol",
    ],
}

