package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_binary {
    name: "android.hardware.oemlock-service.droidlogic",
    vendor: true,
    relative_install_path: "hw",
    init_rc: [
        "android.hardware.oemlock-service.droidlogic.rc",
    ],
    vintf_fragments: [
        "android.hardware.oemlock-service.droidlogic.xml",
    ],
    srcs: [
        "OemLock.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.oemlock-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libdumpstateutil",
        "liblog",
        "libutils",
        "libsystemcontrolservice",
        "vendor.amlogic.hardware.systemcontrol@1.0",
        "vendor.amlogic.hardware.systemcontrol@1.1",
    ],
    cflags: [
        "-DLOG_TAG=\"android.hardware.oemlock-service.droidlogic\"",
    ],
}
