
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_library {
    name: "libdisppower",
    proprietary: true,
    srcs: [
        "disp-power/DisplayLowPower.cpp",
        "disp-power/InteractionHandler.cpp",
    ],
     shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libperfmgr",
        "libutils",
    ],
}

cc_binary {
    name: "android.hardware.power.aidl-service.droidlogic",
    relative_install_path: "hw",
    init_rc: ["default/android.hardware.power-service.libperfmgr.rc"],
    vintf_fragments: ["default/android.hardware.power-service.xml"],
    vendor: true,
    shared_libs: [
        "android.hardware.power-V2-ndk",
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
        "libbinder_ndk",
        "libdisppower",
        "libperfmgr",
    ],
    srcs: [
        "default/service.cpp",
        "default/Power.cpp",
    ],
}
