cc_binary {
        name: "gles_test",
        enabled: true,

        srcs: [
                "foundation/modules/GLUtils/GLUtils.cpp",
                "foundation/platform/android/GraphicBufferUtils/GraphicBufferUtils.cpp",
                "foundation/platform/android/ImageReader/ImageReader.cpp",
                "foundation/platform/android/Painters/BasePainter.cpp",
                "foundation/platform/android/Painters/TrackPainter.cpp",
                "foundation/platform/android/Painters/TexturePainter.cpp",
                "foundation/platform/android/Painters/SurroundPainter.cpp",
                "foundation/platform/android/Painters/CarPainter.cpp",
                "foundation/platform/android/Renderers/BaseRenderer.cpp",
                "foundation/platform/android/Renderers/FrameRenderer.cpp",
                "renderer/Renderer.cpp",
                "tests/main.cpp",
        ],

        include_dirs: [
                "system/memory/libion/include",
		"system/core/libutils/include",
        ],

        local_include_dirs: [
                "foundation/common",
                "foundation/modules/GLUtils/include",
                "foundation/platform/android/GraphicBufferUtils/include",
                "foundation/platform/android/ImageReader/include",
                "foundation/platform/android/Painters/include",
                "foundation/platform/android/Renderers/include",
                "renderer/include",
        ],

        shared_libs: [
                "libion",
                "libEGL",
                "libGLESv2",
                "libutils",
                "libui",
		"libutilscallstack",
        ],

        cflags: [
                "-DDEBUG=1",
                "-DANDROID=1",
        ],
}

