package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_binary {
    name: "android.hardware.thermal-service.droidlogic",
    relative_install_path: "hw",
    init_rc: [":android.hardware.thermal.rc"],
    vintf_fragments: [":android.hardware.thermal.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.thermal-V1-ndk",

        "libutils",

        "libcutils",
        "libjsoncpp",
    ],
    srcs: [
        "main.cpp",
        "Thermal.cpp",

        "ThermalHelper.cpp",
        "utils/config_parser.cpp",
        "utils/thermal_files.cpp",
        "utils/thermal_watcher.cpp",
    ],


    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wunused",
        ],
    tidy: true,
    tidy_checks: [
        "android-*",
        "cert-*",
        "clang-analyzer-security*",
    ],


   tidy_checks_as_errors: [
     "android-*",
     "clang-analyzer-security*",
     "cert-*",
   ],
    //tidy_flags: [
    //     "-warnings-as-errors=android-*,clang-analyzer-security*,cert-*"
    //],
}

filegroup {
    name: "android.hardware.thermal.xml",
    srcs: ["thermal.xml"],
}

filegroup {
    name: "android.hardware.thermal.rc",
    srcs: ["thermal.rc"],
}
