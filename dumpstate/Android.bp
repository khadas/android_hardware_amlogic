package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_binary {
    name: "android.hardware.dumpstate-service.droidlogic",
    relative_install_path: "hw",
    init_rc: ["dumpstate-default.droidlogic.rc"],
    vintf_fragments: ["dumpstate-default.droidlogic.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libdumpstateutil",
        "liblog",
        "libutils",
        "android.hardware.dumpstate-V1-ndk",
    ],
    srcs: [
        "main.cpp",
        "Dumpstate.cpp",
    ],
    cflags: [
        "-DLOG_TAG=\"android.hardware.dumpstate-service.droidlogic\"",
    ],
}

cc_prebuilt_binary {
    name: "dumpstate_display",
    compile_multilib: "32",
    vendor: true,
    arch: {
        arm: {
           srcs: ["dumpstate_display.sh"],
        },
        arm64: {
           srcs: ["dumpstate_display.sh"],
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            enabled: false,
        },
    },
    check_elf_files: false,
}

cc_prebuilt_binary {
    name: "drminfo",
    compile_multilib: "32",
    vendor: true,
    arch: {
        arm: {
           srcs: ["arm/drminfo"],
        },
        arm64: {
            enabled: false,
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            enabled: false,
        },
    },
    check_elf_files: false,
}
