package {
    default_applicable_licenses: ["hardware_amlogic_dumpstate_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "hardware_amlogic_dumpstate_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_binary {
    name: "android.hardware.dumpstate@1.1-service.droidlogic",
    vendor: true,
    relative_install_path: "hw",
    defaults: ["hidl_defaults"],
    init_rc: [
        "android.hardware.dumpstate@1.1-service.droidlogic.rc",
    ],
    vintf_fragments: [
        "android.hardware.dumpstate@1.1-service.droidlogic.xml",
    ],
    srcs: [
        "DumpstateDevice.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.dumpstate@1.0",
        "android.hardware.dumpstate@1.1",
        "libbase",
        "libcutils",
        "libdumpstateutil",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-DLOG_TAG=\"android.hardware.dumpstate@1.1-service.droidlogic\"",
    ],
}
