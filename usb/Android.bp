package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_amlogic_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["hardware_amlogic_license"],
}

soong_config_module_type {
    name: "acme_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "acme",
    variables: ["product"],
    properties: ["cflags", "srcs"],
}

soong_config_string_variable {
	name: "product",
	values: ["t982_gms", "other"],
}

acme_cc_defaults {
    //为该编译配置命名为acme_defaults
    name: "acme_defaults",
    //cflags: ["-DGENERIC"],
    soong_config_variables: {
        product: {
            t982_gms: {
                cflags: ["-DT982_GMS_USB"],
            },
            other: {
                cflags: ["-DUSB_DEFAULT"],
            },
            conditions_default: {
                cflags: ["-DUSB_DEFAULT"],
            },
        },
    },
}

cc_binary {
    name: "android.hardware.usb-service.droidlogic",
    relative_install_path: "hw",
	defaults: ["acme_defaults"],
    init_rc: ["android.hardware.usb-service.rc"],
    vintf_fragments: ["android.hardware.usb-service.xml"],
    vendor: true,
    srcs: [
        "service.cpp",
        "Usb.cpp",
    ],
    shared_libs: [
        "android.hardware.usb-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
    ],
}

filegroup {
    name: "android.hardware.usb-service.xml",
    srcs: ["android.hardware.usb-service.xml"],
}

filegroup {
    name: "android.hardware.usb-service.rc",
    srcs: ["android.hardware.usb-service.rc"],
}
